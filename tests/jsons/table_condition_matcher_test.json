        },
        "expected": false
      }
    ]
  },
  {
    "description": "array field with array $eq and $ne",
    "condition": {
      "tags": {
        "$eq": ["go", "ruby"]
      }
    },
    "records": [
      {
        "data": {
          "tags": ["go", "ruby"]
        },
        "expected": true
      },
      {
        "data": {
          "tags": [["go", "ruby"], "c"]
        },
        "expected": true
      },
      {
        "data": {
          "tags": ["ruby", "go"]
        },
        "expected": false
      }
    ]
  },
  {
    "description": "array of tables exact equality",
    "condition": {
      "items": [
        {
          "a": 1,
          "b": "x"
        }
      ]
    },
    "records": [
      {
        "data": {
          "items": [
            {
              "a": 1,
              "b": "x"
            }
          ]
        },
        "expected": true
      },
      {
        "data": {
          "items": [
            {
              "b": "x",
              "a": 1
            }
          ]
        },
        "expected": true
      },
      {
        "data": {
          "items": [
            {
              "a": 1,
              "b": "y"
            }
          ]
        },
        "expected": false
      },
      {
        "data": {
          "items": [
            {
              "a": 1,
              "b": "x",
              "c": 2
            }
          ]
        },
        "expected": false
      }
    ]
