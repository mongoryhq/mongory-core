  {
    "description": "array field with integer and negative index keys",
    "condition": {
      "tags": {
        "0": "ruby",
        "-1": "c"
      }
    },
    "records": [
      {
        "data": {
          "tags": ["ruby", "go", "c"]
        },
        "expected": true
      },
      {
        "data": {
          "tags": ["c", "go", "ruby"]
        },
        "expected": false
      },
      {
        "data": {
          "tags": {
            "0": "ruby",
            "-1": "c"
          }
        },
        "expected": true
      },
      {
        "data": {
          "tags": [
            {
              "0": "ruby",
              "-1": "c"
            }
          ]
        },
        "expected": false
      }
    ]
  },
  {
    "description": "array field with leading zero key is treated as element field, not index",
    "condition": {
      "tags": {
        "01": "ruby"
      }
    },
    "records": [
      {
        "data": {
          "tags": ["c", "ruby"]
        },
        "expected": false
      },
      {
        "data": {
          "tags": [
            {
              "01": "ruby"
            }
          ]
        },
        "expected": true
      },
      {
        "data": {
          "tags": {
            "01": "ruby"
          }
        },
        "expected": true
      }
    ]
  },
  {
